!windshift-runner/
!windshift-runner/**
!api/
!api/**
!assets/
!assets/**
!internal/
!internal/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/.npmrc
!frontend/index.html
!frontend/jsconfig.json
!frontend/svelte.config.js
!frontend/vite.config.js
!frontend/vite.embed.config.js
!frontend/public/
!frontend/public/**
!frontend/scripts/
!frontend/scripts/**
!frontend/src/
!frontend/src/**
!scripts/
!scripts/demo/
!scripts/demo/generate-demo.js
!scripts/demo/demo-data.js
!scripts/demo/challenge-data.js
!scripts/demo/scale-data.js
