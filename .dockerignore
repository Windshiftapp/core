# Strict build-context allowlist. The Dockerfile needs only the Go module,
# application source, embedded assets, and frontend build inputs.
*
!go.mod
!go.sum
!main.go
!cmd/
!cmd/ws/
!cmd/ws/**
!cmd/windshift-triage/
!cmd/windshift-triage/**
cmd/capture-jira-custom-fields
cmd/logbook
cmd/reviewstatus
cmd/stresstest-cf-index
!windshift-runner/
!windshift-runner/**
!api/
!api/**
!assets/
!assets/**
!internal/
!internal/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/.npmrc
!frontend/index.html
!frontend/jsconfig.json
!frontend/svelte.config.js
!frontend/vite.config.js
!frontend/vite.embed.config.js
!frontend/public/
!frontend/public/**
!frontend/scripts/
!frontend/scripts/**
!frontend/src/
!frontend/src/**
# `!frontend/` above re-includes the whole directory, which otherwise drags the
# developer's node_modules (and their locally built dist) into the context:
# ~900MB on every build, and — worse than slow — `COPY frontend/ ./` lands on
# top of the `npm ci` the frontend-builder stage just ran, so the image would
# build against whatever the host happened to have installed. The stage's own
# node_modules and dist are the only ones that should exist in the image.
frontend/node_modules
frontend/dist
!scripts/
!scripts/demo/
!scripts/demo/generate-demo.js
!scripts/demo/demo-data.js
!scripts/demo/challenge-data.js
!scripts/demo/scale-data.js
