# Refuse to install any package version published less than 14 days ago.
# Blocks fresh supply-chain attacks (e.g. chalk/debug-style) at the package
# manager itself. Per-invocation override: `npm install <pkg> --min-release-age=0`.
# Requires npm >= 11.
min-release-age=14

# Disable postinstall/preinstall scripts — the primary malware execution
# vector during `npm install`. If a specific package legitimately needs its
# scripts, run `npm rebuild <pkg>` explicitly after install.
ignore-scripts=true

# Enforce the `engines` field in package.json as a hard error, not a warning.
# Prevents npm < 11 from silently ignoring min-release-age above.
engine-strict=true

fund=false
