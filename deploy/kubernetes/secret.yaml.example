# EXAMPLE ONLY — do not commit real credentials.
#
# kubectl applies only *.yaml/*.yml/*.json, so this `*.yaml.example` file is
# skipped by `kubectl apply -f deploy/kubernetes/`. Create the real Secret
# first:
#
#   kubectl -n windshift create secret generic windshift-secrets \
#     --from-literal=SSO_SECRET="$(openssl rand -hex 32)"
#
# Add POSTGRES_PASSWORD when using PostgreSQL, and WINDSHIFT_METRICS_TOKEN
# when protecting /metrics:
#
#   kubectl -n windshift create secret generic windshift-secrets \
#     --from-literal=SSO_SECRET="$(openssl rand -hex 32)" \
#     --from-literal=POSTGRES_PASSWORD="..." \
#     --from-literal=WINDSHIFT_METRICS_TOKEN="..."
#
# SSO_SECRET signs sessions and encrypts stored credentials. Keep it stable
# across upgrades; changing it invalidates sessions and stored secrets.
apiVersion: v1
kind: Secret
metadata:
  name: windshift-secrets
  namespace: windshift
type: Opaque
stringData:
  SSO_SECRET: "replace-me-with-openssl-rand-hex-32"
  # POSTGRES_PASSWORD: "..."
  # WINDSHIFT_METRICS_TOKEN: "..."
